# Backend server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public origin the dashboard browser hits the API on
PUBLIC_API_URL=http://localhost:3000
# Where the backend should send the user after a successful OAuth callback
DASHBOARD_URL=http://localhost:5173

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgres://wix_hubspot:wix_hubspot@localhost:5432/wix_hubspot

# 32-byte hex key for AES-256-GCM token encryption.
# Generate with: openssl rand -hex 32   (or Node: crypto.randomBytes(32).toString('hex'))
ENCRYPTION_KEY=

# HubSpot OAuth credentials from your app's "Auth" tab
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback
# OAuth authorize endpoint. Use app-eu1.hubspot.com for EU portals.
HUBSPOT_AUTH_BASE_URL=https://app.hubspot.com
# Space-separated scopes. Defaults cover contacts + webhooks.
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read oauth
# Used to verify v3 signed webhooks from HubSpot
HUBSPOT_WEBHOOK_SECRET=

# Wix OAuth credentials
WIX_APP_ID=
WIX_APP_SECRET=
# Shared secret used to verify Wix webhook signatures
WIX_WEBHOOK_SECRET=

# Internal admin token for dashboard <-> backend requests.
# Pick any long random string and paste the same value into the frontend .env.
INTERNAL_API_TOKEN=
