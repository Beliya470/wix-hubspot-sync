# Same value as backend INTERNAL_API_TOKEN.
# Used by the dashboard to call the backend's authenticated endpoints.
VITE_INTERNAL_API_TOKEN=

# Absolute URL of the backend. Leave blank for local development so the
# Vite dev server's proxy forwards /api and /auth to localhost:3000.
# For production builds, set this to the deployed backend URL,
# e.g. https://wix-hubspot-sync-backend.onrender.com
VITE_API_BASE_URL=
